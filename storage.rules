rules_version = '2';

// Imágenes de comprobantes del respaldo. La ruta es privada por negocio y la membresía se
// comprueba contra Firestore; un cliente manipulado no puede salir de su negocio.
//
// - Subida/purga: siempre denegadas al SDK cliente. Los callables validados usan Admin SDK,
//   decodifican JPEG, aplican compra terminal/cuotas/idempotencia y escriben el objeto.
// - El objeto es inmutable desde el cliente.
// - Descarga (read): miembro verificado + negocio activo + marcador documental COMPLETE.
// - Todo lo demás: denegado.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(businessId) {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        firestore.exists(/databases/(default)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function businessIsActive(businessId) {
      return firestore.exists(/databases/(default)/documents/businesses/$(businessId)) &&
        firestore.get(/databases/(default)/documents/businesses/$(businessId)).data
          .get("accountDeletionLocked", false) != true;
    }

    function hasCompletedDocumentMarker(businessId, purchaseId, imageFile) {
      return resource != null &&
        resource.contentType == "image/jpeg" &&
        resource.metadata.imageId is string &&
        resource.metadata.purchaseId == purchaseId &&
        imageFile == resource.metadata.imageId + ".jpg" &&
        firestore.exists(
          /databases/(default)/documents/businesses/$(businessId)/documentBackups/$(resource.metadata.imageId)
        ) &&
        firestore.get(
          /databases/(default)/documents/businesses/$(businessId)/documentBackups/$(resource.metadata.imageId)
        ).data.status == "COMPLETE" &&
        firestore.get(
          /databases/(default)/documents/businesses/$(businessId)/documentBackups/$(resource.metadata.imageId)
        ).data.purgeRequested == false &&
        firestore.get(
          /databases/(default)/documents/businesses/$(businessId)/documentBackups/$(resource.metadata.imageId)
        ).data.purchaseId == purchaseId &&
        firestore.get(
          /databases/(default)/documents/businesses/$(businessId)/documentBackups/$(resource.metadata.imageId)
        ).data.imageId == resource.metadata.imageId;
    }

    match /businesses/{businessId}/invoices/{purchaseId}/{imageFile} {
      allow read: if isMember(businessId) &&
        businessIsActive(businessId) &&
        hasCompletedDocumentMarker(businessId, purchaseId, imageFile);
      // El contenido solo entra/sale mediante callables con Admin SDK: allí se valida la
      // firma JPEG, dimensiones, checksum, compra terminal, cuota y consentimiento durable.
      allow create, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
