<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Flavor local: la app es offline-first. El modelo OCR va dentro del APK y se elimina
      cualquier permiso de red transitivo; verifyOfflineFirstBoundaries hace cumplir esto.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

</manifest>
