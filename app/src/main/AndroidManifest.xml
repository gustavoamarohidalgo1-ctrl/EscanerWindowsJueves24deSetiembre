<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Único permiso de la app: la cámara, solicitada en runtime y solo al pulsar "Tomar foto".
      Sin permisos de almacenamiento: la galería se abre con el Photo Picker y la imagen
      elegida se copia de inmediato al almacenamiento privado. La cámara es opcional para
      que la app siga instalable en dispositivos sin ella (la galería sigue funcionando).
      La política de red es del flavor: src/local elimina INTERNET; src/cloud lo declara.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:name=".FacturaStockApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FacturaStock"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager se inicializa desde FacturaStockApplication (Configuration.Provider) con
          la factoría Hilt del worker de respaldo. Desde WorkManager 2.9 la inicialización por
          defecto viaja por androidx.startup, así que se retira su Initializer del descubrimiento.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
