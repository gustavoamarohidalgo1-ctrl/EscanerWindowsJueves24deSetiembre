rules_version = '2';

// Plan Spark de FacturaStock. Un negocio pertenece a una sola cuenta verificada y todos los
// hechos operativos conservan ownerUid. No hay borrados físicos: correcciones y anulaciones se
// representan como transiciones cerradas o documentos compensatorios dentro de una transacción.
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerified() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string;
    }

    function isOwner(businessId) {
      return isVerified() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid ==
          request.auth.uid;
    }

    function exact(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function boundedText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function optionalText(value, maximum) {
      return value == null || (value is string && value.size() <= maximum);
    }

    function validId(value) {
      return boundedText(value, 128) && value.matches('^[A-Za-z0-9][A-Za-z0-9._:-]*$');
    }

    function validUuid(value) {
      return value is string &&
        value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }

    function validSha256(value) {
      return value is string && value.matches('^[0-9a-f]{64}$');
    }

    function validMoment(value) {
      return value is timestamp ||
        (value is int && value >= 0 && value <= 9007199254740991);
    }

    function positiveSequence(value) {
      return value is int && value > 0 && value <= 9007199254740991;
    }

    function nonNegativeSequence(value) {
      return value is int && value >= 0 && value <= 9007199254740991;
    }

    function validMinorUnits(value) {
      return value is int && value >= -9007199254740991 && value <= 9007199254740991;
    }

    function validCurrency(value) {
      return value is string && value.matches('^[A-Z]{3}$');
    }

    function signedDecimal(value) {
      return value is string && value.size() <= 165 &&
        value.matches('^-?(0|[1-9][0-9]{0,127})(\\.[0-9]{1,36})?$');
    }

    function nonNegativeDecimal(value) {
      return value is string && value.size() <= 164 &&
        value.matches('^(0|[1-9][0-9]{0,127})(\\.[0-9]{1,36})?$');
    }

    function validBusinessCreate(data, businessId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'displayName', 'ownerUid', 'createdBy', 'createdAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.businessId == businessId && validUuid(businessId) &&
        boundedText(data.displayName, 120) &&
        data.ownerUid == request.auth.uid && data.createdBy == request.auth.uid &&
        validMoment(data.createdAt);
    }

    function validOwnerMember(data, uid, displayName) {
      return exact(data, [
          'schemaVersion', 'uid', 'email', 'role', 'addedAt', 'addedVia', 'ownerUid'
        ]) &&
        data.schemaVersion == 1 && data.uid == uid && uid == request.auth.uid &&
        data.email == request.auth.token.email && data.role == 'OWNER' &&
        data.addedVia == 'spark_direct' && data.ownerUid == request.auth.uid &&
        validMoment(data.addedAt) && boundedText(displayName, 120);
    }

    function validMembershipIndex(data, businessId, uid, displayName) {
      return exact(data, [
          'schemaVersion', 'businessId', 'uid', 'displayName', 'role', 'createdAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId && data.uid == uid &&
        uid == request.auth.uid && data.displayName == displayName &&
        data.role == 'OWNER' && validMoment(data.createdAt);
    }

    function validCatalogEntity(data, businessId, entityId, entityType) {
      return exact(data, [
          'schemaVersion', 'businessId', 'ownerUid', 'operationId', 'entityId',
          'entityType', 'version', 'mutation', 'snapshot', 'snapshotPayload',
          'snapshotSha256', 'receiptId', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        data.ownerUid == request.auth.uid && boundedText(data.operationId, 256) &&
        data.entityId == entityId && validUuid(entityId) &&
        data.entityType == entityType && positiveSequence(data.version) &&
        data.mutation == 'UPSERT' && data.snapshot is map && data.snapshot.size() <= 64 &&
        data.snapshotPayload is string && data.snapshotPayload.size() > 0 &&
        data.snapshotPayload.size() <= 64000 && validSha256(data.snapshotSha256) &&
        semanticIndexId(data.snapshotPayload) == data.snapshotSha256 &&
        data.receiptId.matches('^rcpt_[0-9a-f]{32}$') && validMoment(data.syncedAt) &&
        data.ownerUid == request.auth.uid &&
        ((entityType == 'PRODUCT' && validProductSemanticSnapshot(data.snapshot)) ||
          (entityType == 'SUPPLIER' && validSupplierSemanticSnapshot(data.snapshot)));
    }

    function validProductSemanticSnapshot(snapshot) {
      return snapshot.keys().hasAll(['sku', 'barcode']) &&
        (snapshot.sku == null ||
          (boundedText(snapshot.sku, 64) && snapshot.sku == snapshot.sku.trim() &&
            snapshot.sku == snapshot.sku.upper())) &&
        (snapshot.barcode == null ||
          (boundedText(snapshot.barcode, 128) &&
            snapshot.barcode == snapshot.barcode.trim()));
    }

    function validSupplierSemanticSnapshot(snapshot) {
      return snapshot.keys().hasAll(['ruc']) &&
        (snapshot.ruc == null ||
          (snapshot.ruc is string && snapshot.ruc.matches('^[0-9]{11}$')));
    }

    function semanticIndexId(value) {
      return hashing.sha256(value is string ? value : '').toHexString().lower();
    }

    function validCatalogIndexData(data) {
      return exact(data, ['entityId', 'version']) &&
        validUuid(data.entityId) && positiveSequence(data.version);
    }

    function catalogEntityAdvances(businessId, entityCollection, entityId) {
      let entityPath = /databases/$(database)/documents/businesses/$(businessId)/$(entityCollection)/$(entityId);
      return existsAfter(entityPath) &&
        ((!exists(entityPath) && getAfter(entityPath).data.version == 1) ||
          (exists(entityPath) &&
            getAfter(entityPath).data.version == get(entityPath).data.version + 1));
    }

    function validProductIndexCreate(businessId, indexId, semanticField) {
      let entityPath = /databases/$(database)/documents/businesses/$(businessId)/products/$(request.resource.data.entityId);
      let entity = getAfter(entityPath).data;
      return validCatalogIndexData(request.resource.data) &&
        semanticField in ['sku', 'barcode'] &&
        catalogEntityAdvances(businessId, 'products', request.resource.data.entityId) &&
        validCatalogEntity(entity, businessId, request.resource.data.entityId, 'PRODUCT') &&
        entity.snapshot[semanticField] != null &&
        indexId == semanticIndexId(entity.snapshot[semanticField]) &&
        request.resource.data.version == entity.version;
    }

    function validProductIndexUpdate(businessId, indexId, semanticField) {
      let entityPath = /databases/$(database)/documents/businesses/$(businessId)/products/$(resource.data.entityId);
      let before = get(entityPath).data;
      let after = getAfter(entityPath).data;
      return validCatalogIndexData(resource.data) &&
        validCatalogIndexData(request.resource.data) &&
        request.resource.data.entityId == resource.data.entityId &&
        semanticField in ['sku', 'barcode'] &&
        catalogEntityAdvances(businessId, 'products', resource.data.entityId) &&
        validCatalogEntity(after, businessId, resource.data.entityId, 'PRODUCT') &&
        resource.data.version == before.version &&
        request.resource.data.version == after.version &&
        before.snapshot[semanticField] != null &&
        before.snapshot[semanticField] == after.snapshot[semanticField] &&
        indexId == semanticIndexId(after.snapshot[semanticField]);
    }

    function validProductIndexDelete(businessId, indexId, semanticField) {
      let entityPath = /databases/$(database)/documents/businesses/$(businessId)/products/$(resource.data.entityId);
      let before = get(entityPath).data;
      let after = getAfter(entityPath).data;
      return validCatalogIndexData(resource.data) &&
        semanticField in ['sku', 'barcode'] &&
        catalogEntityAdvances(businessId, 'products', resource.data.entityId) &&
        validCatalogEntity(after, businessId, resource.data.entityId, 'PRODUCT') &&
        resource.data.version == before.version &&
        before.snapshot[semanticField] != null &&
        before.snapshot[semanticField] != after.snapshot[semanticField] &&
        indexId == semanticIndexId(before.snapshot[semanticField]);
    }

    function validSupplierIndexCreate(businessId, indexId) {
      let entityPath = /databases/$(database)/documents/businesses/$(businessId)/suppliers/$(request.resource.data.entityId);
      let entity = getAfter(entityPath).data;
      return validCatalogIndexData(request.resource.data) &&
        catalogEntityAdvances(businessId, 'suppliers', request.resource.data.entityId) &&
        validCatalogEntity(entity, businessId, request.resource.data.entityId, 'SUPPLIER') &&
        entity.snapshot.ruc != null && indexId == semanticIndexId(entity.snapshot.ruc) &&
        request.resource.data.version == entity.version;
    }

    function validSupplierIndexUpdate(businessId, indexId) {
      let entityPath = /databases/$(database)/documents/businesses/$(businessId)/suppliers/$(resource.data.entityId);
      let before = get(entityPath).data;
      let after = getAfter(entityPath).data;
      return validCatalogIndexData(resource.data) &&
        validCatalogIndexData(request.resource.data) &&
        request.resource.data.entityId == resource.data.entityId &&
        catalogEntityAdvances(businessId, 'suppliers', resource.data.entityId) &&
        validCatalogEntity(after, businessId, resource.data.entityId, 'SUPPLIER') &&
        resource.data.version == before.version &&
        request.resource.data.version == after.version &&
        before.snapshot.ruc != null && before.snapshot.ruc == after.snapshot.ruc &&
        indexId == semanticIndexId(after.snapshot.ruc);
    }

    function validSupplierIndexDelete(businessId, indexId) {
      let entityPath = /databases/$(database)/documents/businesses/$(businessId)/suppliers/$(resource.data.entityId);
      let before = get(entityPath).data;
      let after = getAfter(entityPath).data;
      return validCatalogIndexData(resource.data) &&
        catalogEntityAdvances(businessId, 'suppliers', resource.data.entityId) &&
        validCatalogEntity(after, businessId, resource.data.entityId, 'SUPPLIER') &&
        resource.data.version == before.version && before.snapshot.ruc != null &&
        before.snapshot.ruc != after.snapshot.ruc &&
        indexId == semanticIndexId(before.snapshot.ruc);
    }

    function validProductIndexesAfter(businessId, data) {
      let skuPath = /databases/$(database)/documents/businesses/$(businessId)/productSkuIndex/$(semanticIndexId(data.snapshot.sku));
      let barcodePath = /databases/$(database)/documents/businesses/$(businessId)/productBarcodeIndex/$(semanticIndexId(data.snapshot.barcode));
      return (data.snapshot.sku == null ||
          (existsAfter(skuPath) && validCatalogIndexData(getAfter(skuPath).data) &&
            getAfter(skuPath).data.entityId == data.entityId &&
            getAfter(skuPath).data.version == data.version)) &&
        (data.snapshot.barcode == null ||
          (existsAfter(barcodePath) && validCatalogIndexData(getAfter(barcodePath).data) &&
            getAfter(barcodePath).data.entityId == data.entityId &&
            getAfter(barcodePath).data.version == data.version));
    }

    function validSupplierIndexAfter(businessId, data) {
      let rucPath = /databases/$(database)/documents/businesses/$(businessId)/supplierRucIndex/$(semanticIndexId(data.snapshot.ruc));
      return data.snapshot.ruc == null ||
        (existsAfter(rucPath) && validCatalogIndexData(getAfter(rucPath).data) &&
          getAfter(rucPath).data.entityId == data.entityId &&
          getAfter(rucPath).data.version == data.version);
    }

    function productOldIndexesReleased(businessId, before, after) {
      let skuPath = /databases/$(database)/documents/businesses/$(businessId)/productSkuIndex/$(semanticIndexId(before.snapshot.sku));
      let barcodePath = /databases/$(database)/documents/businesses/$(businessId)/productBarcodeIndex/$(semanticIndexId(before.snapshot.barcode));
      return (before.snapshot.sku == null || before.snapshot.sku == after.snapshot.sku ||
          !existsAfter(skuPath)) &&
        (before.snapshot.barcode == null ||
          before.snapshot.barcode == after.snapshot.barcode || !existsAfter(barcodePath));
    }

    function supplierOldIndexReleased(businessId, before, after) {
      let rucPath = /databases/$(database)/documents/businesses/$(businessId)/supplierRucIndex/$(semanticIndexId(before.snapshot.ruc));
      return before.snapshot.ruc == null || before.snapshot.ruc == after.snapshot.ruc ||
        !existsAfter(rucPath);
    }

    function validCatalogChange(data, changeId) {
      return exact(data, [
          'schemaVersion', 'seq', 'entityType', 'entityId', 'version', 'mutation', 'snapshot',
          'snapshotPayload', 'snapshotSha256', 'receiptId', 'syncedAt', 'ownerUid'
        ]) &&
        data.schemaVersion == 1 && positiveSequence(data.seq) &&
        data.entityType in ['PRODUCT', 'SUPPLIER'] && validUuid(data.entityId) &&
        positiveSequence(data.version) && data.mutation == 'UPSERT' &&
        data.snapshot is map && data.snapshot.size() <= 64 &&
        data.snapshotPayload is string && data.snapshotPayload.size() > 0 &&
        data.snapshotPayload.size() <= 64000 && validSha256(data.snapshotSha256) &&
        semanticIndexId(data.snapshotPayload) == data.snapshotSha256 &&
        data.receiptId == changeId && changeId.matches('^rcpt_[0-9a-f]{32}$') &&
        validMoment(data.syncedAt) && data.ownerUid == request.auth.uid &&
        ((data.entityType == 'PRODUCT' && validProductSemanticSnapshot(data.snapshot)) ||
          (data.entityType == 'SUPPLIER' && validSupplierSemanticSnapshot(data.snapshot)));
    }

    function validCatalogOperation(data, businessId, operationId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'ownerUid', 'operationId', 'idempotencyKey',
          'requestHash', 'operationType', 'entityId', 'version', 'receiptId', 'seq',
          'createdAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        data.ownerUid == request.auth.uid && data.operationId == operationId &&
        validSha256(operationId) && boundedText(data.idempotencyKey, 256) &&
        operationId == semanticIndexId(data.idempotencyKey) &&
        validSha256(data.requestHash) &&
        data.operationType in ['SYNC_PRODUCT', 'SYNC_SUPPLIER'] &&
        validUuid(data.entityId) && positiveSequence(data.version) &&
        data.receiptId.matches('^rcpt_[0-9a-f]{32}$') && positiveSequence(data.seq) &&
        validMoment(data.createdAt) && data.ownerUid == request.auth.uid;
    }

    function validCatalogMetadata(data, businessId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'ownerUid', 'seq', 'lastOperationId', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        data.ownerUid == request.auth.uid && positiveSequence(data.seq) &&
        validSha256(data.lastOperationId) && validMoment(data.updatedAt);
    }

    function validCatalogAtomicCommit(businessId, metadata) {
      let operation = getAfter(
        /databases/$(database)/documents/businesses/$(businessId)/catalogSyncOperations/$(metadata.lastOperationId)
      ).data;
      let change = getAfter(
        /databases/$(database)/documents/businesses/$(businessId)/catalogSyncChanges/$(operation.receiptId)
      ).data;
      let entity = operation.operationType == 'SYNC_PRODUCT'
        ? getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/products/$(operation.entityId)
          ).data
        : getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/suppliers/$(operation.entityId)
          ).data;
      return validCatalogOperation(operation, businessId, metadata.lastOperationId) &&
        validCatalogChange(change, operation.receiptId) &&
        operation.seq == metadata.seq && change.seq == metadata.seq &&
        change.entityId == operation.entityId && change.version == operation.version &&
        entity.entityId == operation.entityId && entity.version == operation.version &&
        entity.receiptId == operation.receiptId &&
        entity.operationId == metadata.lastOperationId &&
        change.entityType == entity.entityType && change.mutation == entity.mutation &&
        change.snapshot == entity.snapshot &&
        change.snapshotPayload == entity.snapshotPayload &&
        change.snapshotSha256 == entity.snapshotSha256 &&
        ((operation.operationType == 'SYNC_PRODUCT' && entity.entityType == 'PRODUCT') ||
          (operation.operationType == 'SYNC_SUPPLIER' && entity.entityType == 'SUPPLIER'));
    }

    function validDebtSnapshot(data, businessId, debtId) {
      return data is map &&
        data.keys().hasAll([
          'debtId', 'businessId', 'saleId', 'debtorNameSnapshot', 'currency',
          'originalMinorUnits', 'balanceMinorUnits', 'status', 'dueAt', 'version',
          'createdAt', 'updatedAt', 'paidAt'
        ]) &&
        data.keys().hasOnly([
          'debtId', 'businessId', 'saleId', 'debtorNameSnapshot', 'currency',
          'originalMinorUnits', 'balanceMinorUnits', 'status', 'dueAt', 'version',
          'createdAt', 'updatedAt', 'paidAt'
        ]) &&
        data.debtId == debtId && validId(debtId) && data.businessId == businessId &&
        validId(data.saleId) && boundedText(data.debtorNameSnapshot, 160) &&
        validCurrency(data.currency) && validMinorUnits(data.originalMinorUnits) &&
        data.originalMinorUnits > 0 && validMinorUnits(data.balanceMinorUnits) &&
        data.balanceMinorUnits >= 0 && data.balanceMinorUnits <= data.originalMinorUnits &&
        data.status in ['OPEN', 'PAID'] && (data.dueAt == null || validMoment(data.dueAt)) &&
        positiveSequence(data.version) && validMoment(data.createdAt) &&
        validMoment(data.updatedAt) && (data.paidAt == null || validMoment(data.paidAt));
    }

    function validSaleRecord(data, businessId, saleId) {
      return data.keys().hasAll([
          'version', 'saleId', 'businessId', 'status', 'currency', 'subtotalMinorUnits',
          'discountMinorUnits', 'taxMinorUnits', 'totalMinorUnits', 'contentHash',
          'checkoutIdempotencyKey', 'createdAt', 'updatedAt', 'postedAt', 'lines',
          'schemaVersion', 'operationId', 'idempotencyKey', 'syncPayloadHash', 'actorUid',
          'authorizedRole', 'receiptId', 'inventorySeq', 'expectedInventoryVersions',
          'resultingInventoryVersions', 'balances', 'syncedAt'
        ]) &&
        data.keys().hasOnly([
          'version', 'saleId', 'businessId', 'status', 'currency', 'subtotalMinorUnits',
          'discountMinorUnits', 'taxMinorUnits', 'totalMinorUnits', 'contentHash',
          'checkoutIdempotencyKey', 'createdAt', 'updatedAt', 'postedAt', 'lines',
          'credit', 'schemaVersion', 'operationId', 'idempotencyKey', 'syncPayloadHash',
          'actorUid', 'authorizedRole', 'receiptId', 'inventorySeq',
          'expectedInventoryVersions', 'resultingInventoryVersions', 'balances', 'syncedAt',
          'debt'
        ]) &&
        data.schemaVersion == 1 && data.saleId == saleId && validId(saleId) &&
        data.businessId == businessId && data.status == 'POSTED' &&
        validCurrency(data.currency) && validMinorUnits(data.subtotalMinorUnits) &&
        data.subtotalMinorUnits >= 0 && validMinorUnits(data.discountMinorUnits) &&
        data.discountMinorUnits >= 0 && validMinorUnits(data.taxMinorUnits) &&
        data.taxMinorUnits >= 0 && validMinorUnits(data.totalMinorUnits) &&
        data.totalMinorUnits > 0 && validSha256(data.contentHash) &&
        boundedText(data.checkoutIdempotencyKey, 256) && validMoment(data.createdAt) &&
        validMoment(data.updatedAt) && validMoment(data.postedAt) && data.lines is list &&
        data.lines.size() > 0 && data.lines.size() <= 100 &&
        data.operationId == data.idempotencyKey && boundedText(data.operationId, 256) &&
        validSha256(data.syncPayloadHash) && data.actorUid == request.auth.uid &&
        data.authorizedRole == 'OWNER' && boundedText(data.receiptId, 128) &&
        positiveSequence(data.inventorySeq) && data.expectedInventoryVersions is map &&
        data.resultingInventoryVersions is map && data.balances is list &&
        data.balances.size() > 0 && data.balances.size() <= 100 &&
        validMoment(data.syncedAt) &&
        ((data.version == 1 && !('credit' in data) && !('debt' in data)) ||
          (data.version == 2 && data.credit is map && data.debt is map &&
            validDebtSnapshot(data.debt, businessId, data.credit.debtId)));
    }

    function validSaleLine(data, businessId, saleId, lineId) {
      return exact(data, [
          'saleLineId', 'position', 'productId', 'unitId', 'locationId', 'productName',
          'unitCode', 'locationName', 'barcode', 'quantity', 'unitPriceMinorUnits',
          'discountMinorUnits', 'taxMinorUnits', 'lineTotalMinorUnits', 'schemaVersion',
          'businessId', 'saleId', 'operationId', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId && data.saleId == saleId &&
        data.saleLineId == lineId && validId(lineId) && nonNegativeSequence(data.position) &&
        validId(data.productId) && validId(data.unitId) && validId(data.locationId) &&
        boundedText(data.productName, 240) && boundedText(data.unitCode, 32) &&
        boundedText(data.locationName, 120) && optionalText(data.barcode, 128) &&
        nonNegativeDecimal(data.quantity) && data.quantity != '0' &&
        validMinorUnits(data.unitPriceMinorUnits) && data.unitPriceMinorUnits >= 0 &&
        validMinorUnits(data.discountMinorUnits) && data.discountMinorUnits >= 0 &&
        validMinorUnits(data.taxMinorUnits) && data.taxMinorUnits >= 0 &&
        validMinorUnits(data.lineTotalMinorUnits) && data.lineTotalMinorUnits >= 0 &&
        boundedText(data.operationId, 256) && validMoment(data.syncedAt);
    }

    function validInventoryBalance(data, businessId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'productId', 'locationName',
          'canonicalLocationName', 'quantityOnHand', 'averageUnitCost', 'currency',
          'version', 'lastSeq', 'updatedAtMillis', 'lastSourceLocationId',
          'lastOperationId', 'expectedVersion', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        validId(data.productId) && boundedText(data.locationName, 120) &&
        boundedText(data.canonicalLocationName, 160) && signedDecimal(data.quantityOnHand) &&
        nonNegativeDecimal(data.averageUnitCost) && validCurrency(data.currency) &&
        nonNegativeSequence(data.version) && positiveSequence(data.lastSeq) &&
        validMoment(data.updatedAtMillis) &&
        (data.lastSourceLocationId == null || validId(data.lastSourceLocationId)) &&
        boundedText(data.lastOperationId, 256) &&
        (data.expectedVersion == null || nonNegativeSequence(data.expectedVersion)) &&
        validMoment(data.syncedAt);
    }

    function validStockMovement(data, businessId, movementId) {
      return exact(data, [
          'movementId', 'saleId', 'saleLineId', 'productId', 'sourceLocationId',
          'locationName', 'canonicalLocationName', 'type', 'quantityDelta', 'unitCost',
          'currency', 'occurredAt', 'schemaVersion', 'businessId', 'operationId',
          'expectedInventoryVersion', 'resultingInventoryVersion', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        data.movementId == movementId && validId(movementId) && validId(data.saleId) &&
        validId(data.saleLineId) && validId(data.productId) &&
        validId(data.sourceLocationId) && boundedText(data.locationName, 120) &&
        boundedText(data.canonicalLocationName, 160) && data.type == 'SALE' &&
        signedDecimal(data.quantityDelta) && nonNegativeDecimal(data.unitCost) &&
        validCurrency(data.currency) && validMoment(data.occurredAt) &&
        boundedText(data.operationId, 256) &&
        nonNegativeSequence(data.expectedInventoryVersion) &&
        data.resultingInventoryVersion == data.expectedInventoryVersion + 1 &&
        validMoment(data.syncedAt);
    }

    function validInventoryMetadata(data, businessId) {
      return data.keys().hasAll([
          'schemaVersion', 'businessId', 'seq', 'lastKind', 'lastReceiptId',
          'lastOperationId', 'updatedAt'
        ]) && data.keys().hasOnly([
          'schemaVersion', 'businessId', 'seq', 'bootstrapComplete',
          'bootstrapLedgerHash', 'lastKind', 'lastReceiptId', 'lastOperationId', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        positiveSequence(data.seq) &&
        data.lastKind in ['PURCHASE', 'PURCHASE_VOID', 'SALE', 'DEBT_PAYMENT'] &&
        boundedText(data.lastReceiptId, 128) && boundedText(data.lastOperationId, 256) &&
        validMoment(data.updatedAt) &&
        ((!('bootstrapComplete' in data) && !('bootstrapLedgerHash' in data)) ||
          (data.bootstrapComplete == true && validSha256(data.bootstrapLedgerHash)));
    }

    function validInventoryChange(data, businessId, changeId) {
      return data.keys().hasAll([
          'schemaVersion', 'businessId', 'operationId', 'kind', 'seq', 'receiptId', 'syncedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'businessId', 'operationId', 'kind', 'seq', 'receiptId',
          'sale', 'balances', 'debt', 'payment', 'purchase', 'bootstrap', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        boundedText(data.operationId, 256) &&
        data.kind in ['PURCHASE', 'PURCHASE_VOID', 'SALE', 'DEBT_PAYMENT'] &&
        positiveSequence(data.seq) && data.receiptId == changeId &&
        boundedText(changeId, 128) && validMoment(data.syncedAt) &&
        ((data.kind == 'SALE' && data.sale is map && data.balances is list &&
            !('debt' in data) && !('payment' in data) && !('purchase' in data) &&
            !('bootstrap' in data)) ||
          (data.kind == 'DEBT_PAYMENT' && data.debt is map && data.payment is map &&
            data.sale == null && data.balances is list && data.balances.size() == 0 &&
            !('purchase' in data) && !('bootstrap' in data)) ||
          (data.kind in ['PURCHASE', 'PURCHASE_VOID'] && data.sale == null &&
            data.balances is list && !('purchase' in data) &&
            !('debt' in data) && !('payment' in data) &&
            (!('bootstrap' in data) ||
              (data.kind == 'PURCHASE' && data.bootstrap == true && data.seq == 1))));
    }

    function validSaleKey(data, businessId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'operationId', 'saleId', 'receiptId', 'seq',
          'requestHash', 'expectedInventoryVersions', 'resultingInventoryVersions', 'createdAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        boundedText(data.operationId, 256) && validId(data.saleId) &&
        boundedText(data.receiptId, 128) && positiveSequence(data.seq) &&
        validSha256(data.requestHash) && data.expectedInventoryVersions is map &&
        data.resultingInventoryVersions is map && validMoment(data.createdAt);
    }

    function validOpenedDebt(data, businessId, debtId) {
      return exact(data, [
          'debtId', 'businessId', 'saleId', 'debtorNameSnapshot', 'currency',
          'originalMinorUnits', 'balanceMinorUnits', 'status', 'dueAt', 'version',
          'createdAt', 'updatedAt', 'paidAt', 'schemaVersion', 'operationId',
          'openingOperationId', 'lastOperationId', 'receiptId', 'inventorySeq',
          'actorUid', 'authorizedRole', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.debtId == debtId && validId(debtId) &&
        data.businessId == businessId && validId(data.saleId) &&
        boundedText(data.debtorNameSnapshot, 160) && validCurrency(data.currency) &&
        validMinorUnits(data.originalMinorUnits) && data.originalMinorUnits > 0 &&
        data.balanceMinorUnits == data.originalMinorUnits && data.status == 'OPEN' &&
        (data.dueAt == null || validMoment(data.dueAt)) && data.version == 1 &&
        validMoment(data.createdAt) && data.updatedAt == data.createdAt &&
        data.paidAt == null && data.operationId == data.openingOperationId &&
        data.operationId == data.lastOperationId && boundedText(data.operationId, 256) &&
        boundedText(data.receiptId, 128) && positiveSequence(data.inventorySeq) &&
        data.actorUid == request.auth.uid && data.authorizedRole == 'OWNER' &&
        validMoment(data.syncedAt);
    }

    function validPaidDebt(data, businessId, debtId) {
      return exact(data, [
          'debtId', 'businessId', 'saleId', 'debtorNameSnapshot', 'currency',
          'originalMinorUnits', 'balanceMinorUnits', 'status', 'dueAt', 'version',
          'createdAt', 'updatedAt', 'paidAt', 'schemaVersion', 'operationId',
          'openingOperationId', 'lastOperationId', 'receiptId', 'expectedDebtVersion', 'lastPaymentId',
          'lastPaymentReceiptId', 'inventorySeq', 'actorUid', 'authorizedRole', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.debtId == debtId && validId(debtId) &&
        data.businessId == businessId && validId(data.saleId) &&
        boundedText(data.debtorNameSnapshot, 160) && validCurrency(data.currency) &&
        validMinorUnits(data.originalMinorUnits) && data.originalMinorUnits > 0 &&
        validMinorUnits(data.balanceMinorUnits) && data.balanceMinorUnits >= 0 &&
        data.balanceMinorUnits < data.originalMinorUnits && data.status in ['OPEN', 'PAID'] &&
        ((data.balanceMinorUnits == 0 && data.status == 'PAID' && validMoment(data.paidAt)) ||
          (data.balanceMinorUnits > 0 && data.status == 'OPEN' && data.paidAt == null)) &&
        (data.dueAt == null || validMoment(data.dueAt)) && positiveSequence(data.version) &&
        validMoment(data.createdAt) && validMoment(data.updatedAt) &&
        boundedText(data.operationId, 256) && data.operationId == data.openingOperationId &&
        boundedText(data.lastOperationId, 256) && boundedText(data.receiptId, 128) &&
        nonNegativeSequence(data.expectedDebtVersion) && validId(data.lastPaymentId) &&
        boundedText(data.lastPaymentReceiptId, 128) && positiveSequence(data.inventorySeq) &&
        data.actorUid == request.auth.uid && data.authorizedRole == 'OWNER' &&
        validMoment(data.syncedAt);
    }

    function validDebtPayment(data, businessId, debtId, paymentId) {
      return exact(data, [
          'version', 'paymentId', 'debtId', 'businessId', 'currency', 'amountMinorUnits',
          'method', 'note', 'reference', 'expectedDebtVersion', 'balanceAfterMinorUnits',
          'idempotencyKey', 'occurredAt', 'createdAt', 'schemaVersion', 'operationId',
          'syncPayloadHash', 'actorUid', 'authorizedRole', 'receiptId', 'inventorySeq',
          'resultingDebt', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.version == 1 && data.paymentId == paymentId &&
        validId(paymentId) && data.debtId == debtId && data.businessId == businessId &&
        validCurrency(data.currency) && validMinorUnits(data.amountMinorUnits) &&
        data.amountMinorUnits > 0 &&
        data.method in ['CASH', 'YAPE', 'PLIN', 'BANK_TRANSFER', 'OTHER'] &&
        optionalText(data.note, 500) && optionalText(data.reference, 160) &&
        positiveSequence(data.expectedDebtVersion) &&
        validMinorUnits(data.balanceAfterMinorUnits) && data.balanceAfterMinorUnits >= 0 &&
        data.idempotencyKey == data.operationId && boundedText(data.operationId, 256) &&
        validMoment(data.occurredAt) && validMoment(data.createdAt) &&
        validSha256(data.syncPayloadHash) && data.actorUid == request.auth.uid &&
        data.authorizedRole == 'OWNER' && boundedText(data.receiptId, 128) &&
        positiveSequence(data.inventorySeq) &&
        validDebtSnapshot(data.resultingDebt, businessId, debtId) &&
        data.resultingDebt.version == data.expectedDebtVersion + 1 &&
        data.resultingDebt.balanceMinorUnits == data.balanceAfterMinorUnits &&
        validMoment(data.syncedAt);
    }

    function validDebtPaymentKey(data, businessId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'operationId', 'debtId', 'paymentId', 'receiptId',
          'seq', 'requestHash', 'expectedDebtVersion', 'resultingDebtVersion', 'createdAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        boundedText(data.operationId, 256) && validId(data.debtId) &&
        validId(data.paymentId) && boundedText(data.receiptId, 128) &&
        positiveSequence(data.seq) && validSha256(data.requestHash) &&
        positiveSequence(data.expectedDebtVersion) &&
        data.resultingDebtVersion == data.expectedDebtVersion + 1 &&
        validMoment(data.createdAt);
    }

    function purchaseIdentityHash(data) {
      return semanticIndexId(
        '["' + (data.supplierRuc == null ? '' : data.supplierRuc) + '","' +
        data.documentType + '","' + data.documentSeries + '","' +
        data.documentNumber + '"]'
      );
    }

    function purchaseOverrideSlotHash(data) {
      return semanticIndexId(
        '["OVERRIDE","' + purchaseIdentityHash(data) + '","' +
        data.duplicateOverride.sourceDraftId + '"]'
      );
    }

    function validPurchaseDuplicateOverride(data, purchaseId) {
      let override = data.duplicateOverride;
      return (override == null && data.auditEventIds.size() == 1 &&
          validUuid(data.auditEventIds[0])) ||
        (override is map && exact(override, [
            'existingPurchaseId', 'sourceDraftId', 'auditEventId', 'authorizedRole'
          ]) && validUuid(override.existingPurchaseId) &&
          override.existingPurchaseId != purchaseId && validUuid(override.sourceDraftId) &&
          validUuid(override.auditEventId) && override.authorizedRole == 'OWNER' &&
          data.auditEventIds.size() == 2 && validUuid(data.auditEventIds[0]) &&
          validUuid(data.auditEventIds[1]) &&
          data.auditEventIds[0] != data.auditEventIds[1] &&
          (data.auditEventIds[0] == override.auditEventId ||
            data.auditEventIds[1] == override.auditEventId));
    }

    function validPrimaryPurchaseIndexAfter(data, businessId) {
      let index = getAfter(
        /databases/$(database)/documents/businesses/$(businessId)/documentIndex/$(purchaseIdentityHash(data))
      ).data;
      return index.purchaseId == data.purchaseId && index.receiptId == data.receiptId &&
        index.slot == 'PRIMARY';
    }

    function validOverridePurchaseIndexAfter(data, businessId) {
      let overridePath = /databases/$(database)/documents/businesses/$(businessId)/documentIndex/$(purchaseOverrideSlotHash(data));
      let override = getAfter(overridePath).data;
      return !exists(overridePath) && override.purchaseId == data.purchaseId &&
        override.receiptId == data.receiptId &&
        override.slot == 'OVERRIDE';
    }

    function validPurchaseIndexAfter(data, businessId) {
      return (data.duplicateOverride == null && validPrimaryPurchaseIndexAfter(data, businessId)) ||
        (data.duplicateOverride != null && validOverridePurchaseIndexAfter(data, businessId));
    }

    function validPurchase(data, businessId, purchaseId) {
      return exact(data, [
          'version', 'purchaseId', 'businessId', 'status', 'documentType',
          'documentSeries', 'documentNumber', 'issueDate', 'currency', 'supplierRuc',
          'supplierLegalName', 'subtotalMinorUnits', 'taxMinorUnits',
          'otherChargesMinorUnits', 'totalMinorUnits', 'adjustmentMinorUnits',
          'adjustmentReason', 'preparedLogicalHash', 'postedAt', 'idempotencyKey',
          'lines', 'movements', 'auditEventIds', 'duplicateOverride', 'schemaVersion',
          'ownerUid', 'syncPayloadHash', 'seq', 'movementSummary', 'receiptId',
          'syncedAt', 'syncedBy', 'inventorySeq', 'lastOperationId'
        ]) &&
        data.version == 3 && data.schemaVersion == 1 &&
        data.purchaseId == purchaseId && validId(purchaseId) &&
        data.businessId == businessId && data.status == 'POSTED' &&
        data.documentType in ['INVOICE', 'SALES_RECEIPT', 'CREDIT_NOTE', 'DEBIT_NOTE'] &&
        data.documentSeries is string && data.documentSeries.matches('^[A-Z0-9]{1,4}$') &&
        data.documentNumber is string && data.documentNumber.matches('^[0-9]{1,12}$') &&
        boundedText(data.issueDate, 20) && validCurrency(data.currency) &&
        (data.supplierRuc == null ||
          (data.supplierRuc is string && data.supplierRuc.matches('^[0-9]{11}$'))) &&
        boundedText(data.supplierLegalName, 240) &&
        validMinorUnits(data.subtotalMinorUnits) && data.subtotalMinorUnits >= 0 &&
        validMinorUnits(data.taxMinorUnits) && data.taxMinorUnits >= 0 &&
        validMinorUnits(data.otherChargesMinorUnits) && data.otherChargesMinorUnits >= 0 &&
        validMinorUnits(data.totalMinorUnits) && data.totalMinorUnits >= 0 &&
        (data.adjustmentMinorUnits == null || validMinorUnits(data.adjustmentMinorUnits)) &&
        optionalText(data.adjustmentReason, 500) && validSha256(data.preparedLogicalHash) &&
        validMoment(data.postedAt) && boundedText(data.idempotencyKey, 256) &&
        data.lines is list && data.lines.size() > 0 && data.lines.size() <= 500 &&
        data.movements is list && data.movements.size() > 0 && data.movements.size() <= 1000 &&
        data.auditEventIds is list && validPurchaseDuplicateOverride(data, purchaseId) &&
        data.ownerUid == request.auth.uid && validSha256(data.syncPayloadHash) &&
        positiveSequence(data.seq) && data.movementSummary is list &&
        data.movementSummary.size() > 0 && data.movementSummary.size() <= 1000 &&
        boundedText(data.receiptId, 128) && validMoment(data.syncedAt) &&
        data.syncedBy == request.auth.uid && positiveSequence(data.inventorySeq) &&
        data.lastOperationId == data.idempotencyKey;
    }

    function validVoidedPurchase(data, businessId, purchaseId) {
      return exact(data, [
          'version', 'purchaseId', 'businessId', 'status', 'documentType',
          'documentSeries', 'documentNumber', 'issueDate', 'currency', 'supplierRuc',
          'supplierLegalName', 'subtotalMinorUnits', 'taxMinorUnits',
          'otherChargesMinorUnits', 'totalMinorUnits', 'adjustmentMinorUnits',
          'adjustmentReason', 'preparedLogicalHash', 'postedAt', 'idempotencyKey',
          'lines', 'movements', 'auditEventIds', 'duplicateOverride', 'schemaVersion',
          'ownerUid', 'syncPayloadHash', 'seq', 'movementSummary', 'receiptId',
          'syncedAt', 'syncedBy', 'inventorySeq', 'lastOperationId', 'voidReceiptId',
          'voidIdempotencyKey', 'voidPayloadHash', 'voidReason', 'voidedAt', 'voidedBy',
          'voidInventorySeq'
        ]) &&
        data.version == 3 && data.schemaVersion == 1 && data.purchaseId == purchaseId &&
        data.businessId == businessId && data.status == 'VOIDED' &&
        data.ownerUid == request.auth.uid && positiveSequence(data.seq) &&
        boundedText(data.voidReceiptId, 128) &&
        boundedText(data.voidIdempotencyKey, 256) && validSha256(data.voidPayloadHash) &&
        boundedText(data.voidReason, 500) && validMoment(data.voidedAt) &&
        data.voidedBy == request.auth.uid && positiveSequence(data.voidInventorySeq) &&
        data.lastOperationId == data.voidIdempotencyKey;
    }

    function validPurchaseChange(data, businessId, purchaseId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'ownerUid', 'operationId', 'seq', 'purchaseId',
          'status', 'documentType', 'documentSeries', 'documentNumber', 'issueDate',
          'currency', 'supplierRuc', 'supplierLegalName', 'totalMinorUnits',
          'movementSummary', 'receiptId', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        data.ownerUid == request.auth.uid && boundedText(data.operationId, 256) &&
        positiveSequence(data.seq) && data.purchaseId == purchaseId && validId(purchaseId) &&
        data.status in ['POSTED', 'VOIDED'] && boundedText(data.documentType, 40) &&
        boundedText(data.documentSeries, 40) && boundedText(data.documentNumber, 80) &&
        boundedText(data.issueDate, 20) && validCurrency(data.currency) &&
        optionalText(data.supplierRuc, 32) && boundedText(data.supplierLegalName, 240) &&
        validMinorUnits(data.totalMinorUnits) && data.totalMinorUnits >= 0 &&
        data.movementSummary is list && data.movementSummary.size() > 0 &&
        data.movementSummary.size() <= 1000 && boundedText(data.receiptId, 128) &&
        validMoment(data.syncedAt);
    }

    function validPurchaseKey(data, businessId, keyId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'ownerUid', 'operationId', 'idempotencyKey',
          'purchaseId', 'receiptId', 'seq', 'inventorySeq', 'requestHash', 'createdAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        data.ownerUid == request.auth.uid && validSha256(keyId) &&
        boundedText(data.operationId, 256) &&
        data.idempotencyKey == data.operationId &&
        validId(data.purchaseId) && boundedText(data.receiptId, 128) &&
        positiveSequence(data.seq) && positiveSequence(data.inventorySeq) &&
        validSha256(data.requestHash) && validMoment(data.createdAt);
    }

    function validPurchaseMetadata(data, businessId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'seq', 'lastSyncedAt', 'lastPurchaseId',
          'lastReceiptId', 'lastOperationId'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        positiveSequence(data.seq) && validMoment(data.lastSyncedAt) &&
        validId(data.lastPurchaseId) && boundedText(data.lastReceiptId, 128) &&
        boundedText(data.lastOperationId, 256);
    }

    function validOverrideDocumentIndexRelations(data, businessId, indexId, purchase) {
      let identityId = purchaseIdentityHash(purchase);
      let targetPath = /databases/$(database)/documents/businesses/$(businessId)/purchases/$(data.existingPurchaseId);
      let primaryPath = /databases/$(database)/documents/businesses/$(businessId)/documentIndex/$(identityId);
      let target = get(targetPath).data;
      let primary = get(primaryPath).data;
      return indexId == purchaseOverrideSlotHash(purchase) &&
        data.primaryIdentityHash == identityId &&
        data.sourceDraftId == purchase.duplicateOverride.sourceDraftId &&
        data.existingPurchaseId == purchase.duplicateOverride.existingPurchaseId &&
        exists(targetPath) && exists(primaryPath) && target.status in ['POSTED', 'VOIDED'] &&
        target.businessId == businessId && target.supplierRuc == purchase.supplierRuc &&
        target.documentType == purchase.documentType &&
        target.documentSeries == purchase.documentSeries &&
        target.documentNumber == purchase.documentNumber &&
        primary.purchaseId == data.existingPurchaseId &&
        primary.receiptId == target.receiptId && primary.slot == 'PRIMARY';
    }

    function validDocumentIndex(data, businessId, indexId) {
      let purchase = getAfter(
        /databases/$(database)/documents/businesses/$(businessId)/purchases/$(data.purchaseId)
      ).data;
      return data.schemaVersion == 1 && data.businessId == businessId &&
        data.ownerUid == request.auth.uid && validUuid(data.purchaseId) &&
        boundedText(data.receiptId, 128) && validMoment(data.createdAt) &&
        ((data.slot == 'PRIMARY' && exact(data, [
            'schemaVersion', 'businessId', 'ownerUid', 'purchaseId', 'receiptId', 'slot',
            'createdAt'
          ]) && indexId == purchaseIdentityHash(purchase) &&
          purchase.duplicateOverride == null && purchase.receiptId == data.receiptId) ||
          (data.slot == 'OVERRIDE' && exact(data, [
            'schemaVersion', 'businessId', 'ownerUid', 'purchaseId', 'receiptId', 'slot',
            'primaryIdentityHash', 'sourceDraftId', 'existingPurchaseId', 'createdAt'
          ]) && purchase.duplicateOverride != null &&
          validOverrideDocumentIndexRelations(data, businessId, indexId, purchase) &&
          purchase.receiptId == data.receiptId));
    }

    function validVoidRecord(data, businessId, purchaseId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'ownerUid', 'cloudActorUid', 'purchaseId',
          'operationId', 'idempotencyKey', 'receiptId', 'payload', 'impactHash',
          'voidReason', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        data.ownerUid == request.auth.uid && data.cloudActorUid == request.auth.uid &&
        data.purchaseId == purchaseId && boundedText(data.operationId, 256) &&
        data.idempotencyKey == data.operationId && boundedText(data.receiptId, 128) &&
        boundedText(data.payload, 64000) && validSha256(data.impactHash) &&
        boundedText(data.voidReason, 500) && validMoment(data.syncedAt);
    }

    function validInventoryBootstrap(data, businessId) {
      return exact(data, [
          'schemaVersion', 'businessId', 'ownerUid', 'operationId', 'idempotencyKey',
          'requestHash', 'ledgerHash', 'locations', 'receiptId', 'seq', 'balances',
          'authorizedRole', 'syncedAt'
        ]) &&
        data.schemaVersion == 1 && data.businessId == businessId &&
        data.ownerUid == request.auth.uid &&
        data.operationId == 'inventory-bootstrap:v1:' + businessId &&
        data.idempotencyKey == data.operationId && validSha256(data.requestHash) &&
        validSha256(data.ledgerHash) && data.locations is list &&
        data.locations.size() > 0 && data.locations.size() <= 200 &&
        data.receiptId.matches('^inventory_bootstrap_[0-9a-f]{32}$') && data.seq == 1 &&
        data.balances is list && data.balances.size() > 0 && data.balances.size() <= 200 &&
        data.authorizedRole == 'OWNER' && validMoment(data.syncedAt);
    }

    match /users/{uid}/memberships/{businessId} {
      allow read: if isVerified() && uid == request.auth.uid;
      allow create: if isVerified() && uid == request.auth.uid &&
        validBusinessCreate(
          getAfter(/databases/$(database)/documents/businesses/$(businessId)).data,
          businessId
        ) &&
        validMembershipIndex(
          request.resource.data,
          businessId,
          uid,
          getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.displayName
        );
      allow update, delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if isOwner(businessId);
      allow create: if isVerified() && validBusinessCreate(request.resource.data, businessId) &&
        validOwnerMember(
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)
          ).data,
          request.auth.uid,
          request.resource.data.displayName
        ) &&
        validMembershipIndex(
          getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(businessId)
          ).data,
          businessId,
          request.auth.uid,
          request.resource.data.displayName
        );
      allow update, delete: if false;

      match /members/{uid} {
        allow read: if isOwner(businessId);
        allow create: if isVerified() && uid == request.auth.uid &&
          validBusinessCreate(
            getAfter(/databases/$(database)/documents/businesses/$(businessId)).data,
            businessId
          ) &&
          validOwnerMember(
            request.resource.data,
            uid,
            getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.displayName
          );
        allow update, delete: if false;
      }

      match /products/{entityId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validCatalogEntity(request.resource.data, businessId, entityId, 'PRODUCT') &&
          request.resource.data.version == 1 &&
          validProductIndexesAfter(businessId, request.resource.data) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/catalogMetadata
          ).data.lastOperationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/catalogSyncOperations/$(request.resource.data.operationId)
          ).data.entityId == entityId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/catalogSyncOperations/$(request.resource.data.operationId)
          ).data.operationType == 'SYNC_PRODUCT';
        allow update: if isOwner(businessId) &&
          validCatalogEntity(request.resource.data, businessId, entityId, 'PRODUCT') &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.version == resource.data.version + 1 &&
          validProductIndexesAfter(businessId, request.resource.data) &&
          productOldIndexesReleased(businessId, resource.data, request.resource.data) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/catalogMetadata
          ).data.lastOperationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/catalogSyncOperations/$(request.resource.data.operationId)
          ).data.entityId == entityId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/catalogSyncOperations/$(request.resource.data.operationId)
          ).data.operationType == 'SYNC_PRODUCT';
        allow delete: if false;
      }

      match /suppliers/{entityId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validCatalogEntity(request.resource.data, businessId, entityId, 'SUPPLIER') &&
          request.resource.data.version == 1 &&
          validSupplierIndexAfter(businessId, request.resource.data) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/catalogMetadata
          ).data.lastOperationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/catalogSyncOperations/$(request.resource.data.operationId)
          ).data.entityId == entityId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/catalogSyncOperations/$(request.resource.data.operationId)
          ).data.operationType == 'SYNC_SUPPLIER';
        allow update: if isOwner(businessId) &&
          validCatalogEntity(request.resource.data, businessId, entityId, 'SUPPLIER') &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.version == resource.data.version + 1 &&
          validSupplierIndexAfter(businessId, request.resource.data) &&
          supplierOldIndexReleased(businessId, resource.data, request.resource.data) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/catalogMetadata
          ).data.lastOperationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/catalogSyncOperations/$(request.resource.data.operationId)
          ).data.entityId == entityId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/catalogSyncOperations/$(request.resource.data.operationId)
          ).data.operationType == 'SYNC_SUPPLIER';
        allow delete: if false;
      }

      match /productSkuIndex/{indexId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validProductIndexCreate(businessId, indexId, 'sku');
        allow update: if isOwner(businessId) &&
          validProductIndexUpdate(businessId, indexId, 'sku');
        allow delete: if isOwner(businessId) &&
          validProductIndexDelete(businessId, indexId, 'sku');
      }

      match /productBarcodeIndex/{indexId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validProductIndexCreate(businessId, indexId, 'barcode');
        allow update: if isOwner(businessId) &&
          validProductIndexUpdate(businessId, indexId, 'barcode');
        allow delete: if isOwner(businessId) &&
          validProductIndexDelete(businessId, indexId, 'barcode');
      }

      match /supplierRucIndex/{indexId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validSupplierIndexCreate(businessId, indexId);
        allow update: if isOwner(businessId) &&
          validSupplierIndexUpdate(businessId, indexId);
        allow delete: if isOwner(businessId) &&
          validSupplierIndexDelete(businessId, indexId);
      }

      match /catalogSyncChanges/{changeId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validCatalogChange(request.resource.data, changeId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/catalogMetadata
          ).data.seq == request.resource.data.seq;
        allow update, delete: if false;
      }

      match /catalogSyncOperations/{operationId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validCatalogOperation(request.resource.data, businessId, operationId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/catalogMetadata
          ).data.seq == request.resource.data.seq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/catalogMetadata
          ).data.lastOperationId == operationId;
        allow update, delete: if false;
      }

      match /sync/catalogMetadata {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validCatalogMetadata(request.resource.data, businessId) &&
          request.resource.data.seq == 1 &&
          validCatalogAtomicCommit(businessId, request.resource.data);
        allow update: if isOwner(businessId) &&
          validCatalogMetadata(request.resource.data, businessId) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.seq == resource.data.seq + 1 &&
          validCatalogAtomicCommit(businessId, request.resource.data);
        allow delete: if false;
      }

      match /sales/{saleId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validSaleRecord(request.resource.data, businessId, saleId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.inventorySeq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.lastOperationId == request.resource.data.operationId;
        allow update, delete: if false;

        match /lines/{lineId} {
          allow read: if isOwner(businessId);
          allow create: if isOwner(businessId) &&
            validSaleLine(request.resource.data, businessId, saleId, lineId) &&
            getAfter(
              /databases/$(database)/documents/businesses/$(businessId)/sales/$(saleId)
            ).data.operationId == request.resource.data.operationId;
          allow update, delete: if false;
        }
      }

      match /stockMovements/{movementId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validStockMovement(request.resource.data, businessId, movementId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sales/$(request.resource.data.saleId)
          ).data.operationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.lastOperationId == request.resource.data.operationId;
        allow update, delete: if false;
      }

      match /inventoryBalances/{balanceId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validInventoryBalance(request.resource.data, businessId) &&
          request.resource.data.version == 0 && request.resource.data.expectedVersion == null &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.lastSeq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.lastOperationId == request.resource.data.lastOperationId;
        allow update: if isOwner(businessId) &&
          validInventoryBalance(request.resource.data, businessId) &&
          request.resource.data.productId == resource.data.productId &&
          request.resource.data.locationName == resource.data.locationName &&
          request.resource.data.canonicalLocationName == resource.data.canonicalLocationName &&
          request.resource.data.currency == resource.data.currency &&
          request.resource.data.expectedVersion == resource.data.version &&
          request.resource.data.version == resource.data.version + 1 &&
          request.resource.data.lastSeq > resource.data.lastSeq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.lastSeq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.lastOperationId == request.resource.data.lastOperationId;
        allow delete: if false;
      }

      match /inventorySyncChanges/{changeId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validInventoryChange(request.resource.data, businessId, changeId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.seq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.lastOperationId == request.resource.data.operationId;
        allow update, delete: if false;
      }

      match /saleSyncKeys/{keyId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) && validSaleKey(request.resource.data, businessId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sales/$(request.resource.data.saleId)
          ).data.operationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.seq;
        allow update, delete: if false;
      }

      match /sync/inventoryMetadata {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validInventoryMetadata(request.resource.data, businessId) &&
          request.resource.data.seq == 1 &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/inventorySyncChanges/$(request.resource.data.lastReceiptId)
          ).data.seq == request.resource.data.seq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/inventorySyncChanges/$(request.resource.data.lastReceiptId)
          ).data.operationId == request.resource.data.lastOperationId &&
          (!('bootstrapComplete' in request.resource.data) ||
            (getAfter(
              /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryBootstrap
            ).data.operationId == request.resource.data.lastOperationId &&
              getAfter(
                /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryBootstrap
              ).data.ledgerHash == request.resource.data.bootstrapLedgerHash));
        allow update: if isOwner(businessId) &&
          validInventoryMetadata(request.resource.data, businessId) &&
          request.resource.data.seq == resource.data.seq + 1 &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/inventorySyncChanges/$(request.resource.data.lastReceiptId)
          ).data.seq == request.resource.data.seq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/inventorySyncChanges/$(request.resource.data.lastReceiptId)
          ).data.operationId == request.resource.data.lastOperationId &&
          ((('bootstrapComplete' in resource.data) &&
              request.resource.data.bootstrapComplete == true &&
              request.resource.data.bootstrapLedgerHash == resource.data.bootstrapLedgerHash) ||
            (!('bootstrapComplete' in resource.data) &&
              !('bootstrapComplete' in request.resource.data) &&
              !('bootstrapLedgerHash' in request.resource.data)));
        allow delete: if false;
      }

      match /sync/inventoryBootstrap {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validInventoryBootstrap(request.resource.data, businessId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.bootstrapLedgerHash == request.resource.data.ledgerHash &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.lastOperationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/inventorySyncChanges/$(request.resource.data.receiptId)
          ).data.bootstrap == true;
        allow update, delete: if false;
      }

      match /debts/{debtId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validOpenedDebt(request.resource.data, businessId, debtId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sales/$(request.resource.data.saleId)
          ).data.operationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.inventorySeq;
        allow update: if isOwner(businessId) &&
          validPaidDebt(request.resource.data, businessId, debtId) &&
          request.resource.data.saleId == resource.data.saleId &&
          request.resource.data.debtorNameSnapshot == resource.data.debtorNameSnapshot &&
          request.resource.data.currency == resource.data.currency &&
          request.resource.data.originalMinorUnits == resource.data.originalMinorUnits &&
          request.resource.data.dueAt == resource.data.dueAt &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.operationId == resource.data.operationId &&
          request.resource.data.openingOperationId == resource.data.openingOperationId &&
          request.resource.data.receiptId == resource.data.receiptId &&
          request.resource.data.expectedDebtVersion == resource.data.version &&
          request.resource.data.version == resource.data.version + 1 &&
          request.resource.data.updatedAt >= resource.data.updatedAt &&
          request.resource.data.balanceMinorUnits < resource.data.balanceMinorUnits &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/debts/$(debtId)/payments/$(request.resource.data.lastPaymentId)
          ).data.operationId == request.resource.data.lastOperationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/debts/$(debtId)/payments/$(request.resource.data.lastPaymentId)
          ).data.amountMinorUnits ==
            resource.data.balanceMinorUnits - request.resource.data.balanceMinorUnits &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.inventorySeq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.lastOperationId == request.resource.data.lastOperationId;
        allow delete: if false;

        match /payments/{paymentId} {
          allow read: if isOwner(businessId);
          allow create: if isOwner(businessId) &&
            validDebtPayment(request.resource.data, businessId, debtId, paymentId) &&
            getAfter(
              /databases/$(database)/documents/businesses/$(businessId)/debts/$(debtId)
            ).data.lastPaymentId == paymentId &&
            getAfter(
              /databases/$(database)/documents/businesses/$(businessId)/debts/$(debtId)
            ).data.lastOperationId == request.resource.data.operationId &&
            getAfter(
              /databases/$(database)/documents/businesses/$(businessId)/debts/$(debtId)
            ).data.version == request.resource.data.resultingDebt.version &&
            getAfter(
              /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
            ).data.seq == request.resource.data.inventorySeq;
          allow update, delete: if false;
        }
      }

      match /debtPaymentSyncKeys/{keyId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validDebtPaymentKey(request.resource.data, businessId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/debts/$(request.resource.data.debtId)/payments/$(request.resource.data.paymentId)
          ).data.operationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.seq;
        allow update, delete: if false;
      }

      match /purchases/{purchaseId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validPurchase(request.resource.data, businessId, purchaseId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/metadata
          ).data.seq == request.resource.data.seq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.inventorySeq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/metadata
          ).data.lastOperationId == request.resource.data.lastOperationId &&
          validPurchaseIndexAfter(request.resource.data, businessId);
        allow update: if isOwner(businessId) &&
          resource.data.status == 'POSTED' &&
          validVoidedPurchase(request.resource.data, businessId, purchaseId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'seq', 'lastOperationId', 'voidReceiptId', 'voidIdempotencyKey',
            'voidPayloadHash', 'voidReason', 'voidedAt', 'voidedBy', 'voidInventorySeq'
          ]) &&
          request.resource.data.seq > resource.data.seq &&
          request.resource.data.voidInventorySeq > resource.data.inventorySeq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/metadata
          ).data.seq == request.resource.data.seq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.voidInventorySeq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/purchases/$(purchaseId)/voidRecord/record
          ).data.operationId == request.resource.data.lastOperationId;
        allow delete: if false;

        match /voidRecord/{recordId} {
          allow read: if isOwner(businessId);
          allow create: if isOwner(businessId) && recordId == 'record' &&
            validVoidRecord(request.resource.data, businessId, purchaseId) &&
            getAfter(
              /databases/$(database)/documents/businesses/$(businessId)/purchases/$(purchaseId)
            ).data.lastOperationId == request.resource.data.operationId;
          allow update, delete: if false;
        }
      }

      match /syncChanges/{purchaseId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validPurchaseChange(request.resource.data, businessId, purchaseId) &&
          request.resource.data.status == 'POSTED' &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/purchases/$(purchaseId)
          ).data.lastOperationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/metadata
          ).data.seq == request.resource.data.seq;
        allow update: if isOwner(businessId) && resource.data.status == 'POSTED' &&
          validPurchaseChange(request.resource.data, businessId, purchaseId) &&
          request.resource.data.status == 'VOIDED' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'seq', 'operationId', 'syncedAt'
          ]) && request.resource.data.seq > resource.data.seq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/purchases/$(purchaseId)
          ).data.lastOperationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/metadata
          ).data.seq == request.resource.data.seq;
        allow delete: if false;
      }

      match /syncKeys/{keyId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validPurchaseKey(request.resource.data, businessId, keyId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/purchases/$(request.resource.data.purchaseId)
          ).data.lastOperationId == request.resource.data.operationId &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/metadata
          ).data.seq == request.resource.data.seq &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/sync/inventoryMetadata
          ).data.seq == request.resource.data.inventorySeq;
        allow update, delete: if false;
      }

      match /documentIndex/{indexId} {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) && validSha256(indexId) &&
          validDocumentIndex(request.resource.data, businessId, indexId) &&
          getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/purchases/$(request.resource.data.purchaseId)
          ).data.receiptId == request.resource.data.receiptId;
        allow update, delete: if false;
      }

      match /sync/metadata {
        allow read: if isOwner(businessId);
        allow create: if isOwner(businessId) &&
          validPurchaseMetadata(request.resource.data, businessId) &&
          request.resource.data.seq == 1;
        allow update: if isOwner(businessId) &&
          validPurchaseMetadata(request.resource.data, businessId) &&
          request.resource.data.seq == resource.data.seq + 1;
        allow delete: if false;
      }

      // Los ledgers se abren gradualmente con validadores exactos más abajo. Mientras una ruta
      // no tenga contrato explícito permanece fail-closed por el catch-all final.
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
