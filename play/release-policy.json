{
  "schemaVersion": 1,
  "artifactPolicy": {
    "sameAabSha256AcrossStages": true,
    "sameVersionCodeAcrossStages": true,
    "rebuildBetweenStages": false
  },
  "stages": [
    {
      "id": "artifact-verified",
      "track": null,
      "userFraction": null,
      "minimumObservationHours": 0
    },
    {
      "id": "internal",
      "track": "internal",
      "userFraction": null,
      "minimumObservationHours": 24
    },
    {
      "id": "production-1",
      "track": "production",
      "userFraction": 0.01,
      "minimumObservationHours": 24
    },
    {
      "id": "production-5",
      "track": "production",
      "userFraction": 0.05,
      "minimumObservationHours": 24
    },
    {
      "id": "production-20",
      "track": "production",
      "userFraction": 0.2,
      "minimumObservationHours": 48
    },
    {
      "id": "production-50",
      "track": "production",
      "userFraction": 0.5,
      "minimumObservationHours": 48
    },
    {
      "id": "production-100",
      "track": "production",
      "userFraction": 1.0,
      "minimumObservationHours": 0
    }
  ],
  "allowedTransitions": [
    ["artifact-verified", "internal"],
    ["internal", "production-1"],
    ["production-1", "production-5"],
    ["production-5", "production-20"],
    ["production-20", "production-50"],
    ["production-50", "production-100"]
  ],
  "promotionGates": {
    "manualApprovalRequired": true,
    "observationWindowRequired": true,
    "versionScopedHealthReviewRequired": true,
    "haltBeforeHotfix": true
  },
  "hotfixPolicy": {
    "higherVersionCodeRequired": true,
    "roomSchemaForwardOnly": true,
    "retainLatestEntitiesAndMigrations": true,
    "userDataResetForbidden": true
  }
}
